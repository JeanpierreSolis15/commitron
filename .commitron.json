{
  "$schema": "https://raw.githubusercontent.com/JeanpierreSolis15/commitron/main/schema.json",

  "model": "sonnet",
  "language": "en",

  "scopes": [
    "cli",
    "app",
    "config",
    "message",
    "prompt",
    "git",
    "claude",
    "terminal",
    "ui",
    "ci",
    "docs",
    "release",
    "deps"
  ],

  "subjectMaxLength": 72,
  "body": "auto",

  "exclude": ["pnpm-lock.yaml", "package-lock.json", "yarn.lock", "*.lock"],

  "guidelines": ["Use a scope only when the change is confined to one layer or module"],
  "examples": [],

  "confirm": true
}
